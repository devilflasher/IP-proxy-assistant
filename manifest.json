{
    "name": "IP代理助手",
    "description": "管理和切换 Chrome 代理，支持 HTTP、HTTPS 以及无认证的 SOCKS4/SOCKS5，并提供代理冲突与错误提示。",
    "version": "4.0.0",
    "manifest_version": 3,
    "icons": {
        "16": "img/16.png",
        "48": "img/48.png",
        "128": "img/128.png"
    },
    "background": {
        "service_worker": "background.js",
        "type": "module"
    },
    "action": {
        "default_icon": "img/128.png",
        "default_title": "IP代理助手 v4.0",
        "default_popup": "popup.html"
    },
    
    "permissions": [
        "storage",
        "proxy",
        "webRequest",
        "webRequestAuthProvider"
    ],
    "host_permissions": [
        "<all_urls>"
    ]
}
